# .gitignore
# Excludes local environments, secrets, caches, generated data, and IDE files.

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Environment / secrets
.env
.env.*
!.env.example

# Local data
data/
logs/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Coverage
.coverage
htmlcov/

# Generated landing batches and local checkpoints
data/