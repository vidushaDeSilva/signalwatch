# .env.example
# Template for local SignalWatch configuration.
# Copy this file to .env before running the project.
# Never store real secrets in this file.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Kafka Docker image.
KAFKA_IMAGE=apache/kafka:4.3.1

# Fixed local-development KRaft cluster ID.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Python applications use the host-exposed Kafka listener.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# S0-only smoke-test resources.
KAFKA_TEST_TOPIC=signalwatch.s0.smoke
KAFKA_TEST_CONSUMER_GROUP=signalwatch-s0-smoke

# S1: Bluesky Jetstream collector
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
JETSTREAM_COLLECTION=app.bsky.feed.post

# Locally persisted position for reconnect/restart
JETSTREAM_CURSOR_FILE=data/checkpoints/bluesky_cursor.json

# Re-read a small overlap to reduce reconnect gaps.
JETSTREAM_REPLAY_OVERLAP_SECONDS=5

# Avoid one disk write or log line for every event.
JETSTREAM_CURSOR_SAVE_EVERY=100
JETSTREAM_LOG_EVERY=100

# S2: Bluesky Kafka event stream
KAFKA_BLUESKY_TOPIC=signalwatch.bluesky.posts.v1
KAFKA_BLUESKY_CONSUMER_GROUP=signalwatch-bluesky-inspector-v1

# Separate from the S1 console-only checkpoint.
KAFKA_BLUESKY_CURSOR_FILE=data/checkpoints/bluesky_kafka_cursor.json

# Small batches for understandable local testing.
KAFKA_PRODUCER_BATCH_SIZE=100
KAFKA_PRODUCER_FLUSH_SECONDS=2

# Manual consumer offset commit frequency.
KAFKA_CONSUMER_COMMIT_EVERY=100

# S3: landing consumer
KAFKA_LANDING_CONSUMER_GROUP=signalwatch-bluesky-landing-v1

LANDING_DIR=data/landing
LANDING_BATCH_SIZE=200
LANDING_FLUSH_SECONDS=10

# Stop safely when local storage becomes critically low.
LANDING_MIN_FREE_MB=256

# Delete abandoned temporary work, but never unuploaded ready batches.
LANDING_STAGING_STALE_MINUTES=60
LANDING_ARCHIVED_RETENTION_DAYS=7

# S4: Databricks Free Edition authentication profile
DATABRICKS_CONFIG_PROFILE=signalwatch

# Replace the catalog if your workspace uses another writable catalog.
SIGNALWATCH_VOLUME_PATH=/Volumes/signalwatch/bronze/landing

# Run continuously, but avoid excessive API polling.
DATABRICKS_UPLOAD_POLL_SECONDS=15
DATABRICKS_UPLOAD_MAX_BATCHES_PER_CYCLE=5